extends Node2D

var velocity: Vector2 = Vector2.ZERO
var in_motion: bool = false
var radius: float = 16.0

func _draw() -> void:
    var points: PackedVector2Array = []
    for i in range(32):
        var a = deg_to_rad(i * (360.0 / 32.0))
        points.append(Vector2(cos(a), sin(a)) * radius)
    draw_colored_polygon(points, Color(1.0, 0.94, 0.75, 1.0))
    draw_arc(Vector2.ZERO, radius * 0.7, 0.0, TAU, 18, Color(0.56, 0.38, 0.16, 1.0), 2.0)
    draw_circle(Vector2(0, 0), radius * 0.25, Color(0.96, 0.92, 0.84, 1.0))

func _process(delta: float) -> void:
    if not in_motion:
        return

    position += velocity * delta

    if position.y <= 90.0 + radius or position.y >= 630.0 - radius:
        position.y = clamp(position.y, 90.0 + radius, 630.0 - radius)
        velocity.y *= -0.82

    if position.x <= 100.0 + radius or position.x >= 1190.0 - radius:
        position.x = clamp(position.x, 100.0 + radius, 1190.0 - radius)
        velocity.x *= -0.72

    velocity *= 0.995
    if velocity.length() < 25.0:
        in_motion = false
        velocity = Vector2.ZERO

func kick(direction: Vector2, power: float) -> void:
    velocity = direction.normalized() * power
    in_motion = true
